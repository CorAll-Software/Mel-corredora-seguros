---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSession, dummyVerify, LoginThrottle, readSession, verifyPassword } from '../../server/auth';
import { clientIp } from '../../server/http';
import { SERVER_ENV } from '../../server/env';
import { AdminRepository } from '../../server/repositories/admin.repository';

export const prerender = false;

// Solo se vuelve a rutas del panel tras iniciar sesión (evita redirecciones abiertas).
function safeNext(value: string | null): string {
  return value && /^\/admin(\/|$|\?)/.test(value) && !value.startsWith('//') ? value : '/admin';
}

const next = safeNext(Astro.url.searchParams.get('next'));

// Con sesión vigente no tiene sentido volver a pedir la clave.
if (Astro.request.method === 'GET' && (await readSession(Astro.cookies, 'admin')) !== null) {
  return Astro.redirect(next, 303);
}

let error: string | undefined;
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  const ip = clientIp(Astro.request, Astro.clientAddress) ?? 'desconocida';
  const keys = [`ip:${ip}`, `email:${email}`];

  if (await LoginThrottle.isBlocked('admin', keys)) {
    Astro.response.status = 429;
    error = `Demasiados intentos. Espera ${LoginThrottle.windowMinutes} minutos y vuelve a probar.`;
  } else if (!email || !password) {
    Astro.response.status = 400;
    error = 'Escribe tu correo y tu contraseña.';
  } else {
    const user = await AdminRepository.findByEmail(email);
    const valid = user ? await verifyPassword(user.passwordHash, password) : await dummyVerify(password);
    if (user && valid) {
      await LoginThrottle.clear('admin', keys);
      await AdminRepository.touchLogin(user.id);
      const secure = SERVER_ENV.isProduction || Astro.url.protocol === 'https:';
      await createSession(Astro.cookies, 'admin', user.id, secure);
      return Astro.redirect(next, 303);
    }
    await LoginThrottle.recordFailure('admin', keys);
    Astro.response.status = 401;
    // Mensaje genérico: no revela si falló el correo o la contraseña.
    error = 'El correo o la contraseña no son correctos.';
  }
}
---

<AdminLayout title="Ingresar" bare>
  <section class="admin-login" aria-labelledby="login-title">
    <p class="eyebrow">Panel privado</p>
    <h1 id="login-title" class="admin-login__title">Hola, Melanie</h1>
    <p class="admin-login__lead">Ingresa para revisar recomendaciones, solicitudes y documentos.</p>

    {
      error && (
        <p class="admin-alert admin-alert--error" role="alert">
          {error}
        </p>
      )
    }

    <form method="post" class="admin-form">
      <label class="admin-field">
        <span class="admin-field__label">Correo</span>
        <input class="admin-field__input" type="email" name="email" autocomplete="username" required value={email} />
      </label>
      <label class="admin-field">
        <span class="admin-field__label">Contraseña</span>
        <input class="admin-field__input" type="password" name="password" autocomplete="current-password" required />
      </label>
      <button type="submit" class="btn-chunk btn-chunk--orange admin-form__submit">Ingresar</button>
    </form>
  </section>
</AdminLayout>
