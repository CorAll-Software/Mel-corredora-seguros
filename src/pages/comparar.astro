---
import MainLayout from '../layouts/MainLayout.astro';
import ComparadorWizard from '../components/comparador/ComparadorWizard';
import { BRAND_CONFIG } from '../core/config/brand.config';
---

<MainLayout title={`Compara seguros con Mepo | ${BRAND_CONFIG.brandTitle}`}>
  <app-comparador>
    <section class="section cmp-page">
      <div class="container">
        <ComparadorWizard client:load />
      </div>
    </section>
  </app-comparador>
</MainLayout>
