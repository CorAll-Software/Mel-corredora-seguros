---
// El portal ahora vive en /portal y se ingresa por /ingresar (issue #48). Se
// mantiene esta dirección para enlaces viejos y para el correo de recuperación.
export const prerender = false;

const token = Astro.url.searchParams.get('restablecer');
return Astro.redirect(token ? `/portal/restablecer?token=${encodeURIComponent(token)}` : '/ingresar', 301);
---
