---
import { Upload } from 'lucide-preact';

// Selector de archivo del panel: zona punteada para arrastrar o hacer clic, que
// muestra el nombre del archivo elegido. El input real cubre la zona (invisible),
// así el arrastre, el clic y el teclado funcionan como en el input nativo.
interface Props {
  label: string;
  name: string;
  accept: string;
  hint: string;
  invalid?: boolean;
}

const { label, name, accept, hint, invalid = false } = Astro.props;
---

<div class="admin-field">
  <span class="admin-field__label">{label}</span>
  <label class:list={['file-drop', { 'file-drop--invalid': invalid }]} data-file-drop>
    <input class="file-drop__input" type="file" name={name} accept={accept} required aria-invalid={invalid ? 'true' : undefined} />
    <span class="file-drop__icon" aria-hidden="true"><Upload size={22} /></span>
    <span class="file-drop__text">
      <strong data-file-drop-name>Elige un archivo o arrástralo aquí</strong>
      <span>{hint}</span>
    </span>
  </label>
</div>

<script is:inline>
  (() => {
    if (window.__fileDrop) return;
    window.__fileDrop = true;
    document.addEventListener('change', (event) => {
      const input = event.target;
      const zona = input instanceof HTMLInputElement && input.closest('[data-file-drop]');
      if (!zona) return;
      const nombre = zona.querySelector('[data-file-drop-name]');
      const archivo = input.files && input.files[0];
      nombre.textContent = archivo ? archivo.name : 'Elige un archivo o arrástralo aquí';
      zona.classList.toggle('file-drop--ready', Boolean(archivo));
    });
    for (const tipo of ['dragenter', 'dragleave', 'drop']) {
      document.addEventListener(tipo, (event) => {
        const zona = event.target instanceof Element && event.target.closest('[data-file-drop]');
        if (zona) zona.classList.toggle('file-drop--over', tipo === 'dragenter');
      });
    }
  })();
</script>
