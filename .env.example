# Plantilla de variables de entorno (sin secretos). Copiar como .env y completar.

# ── LANDING ──────────────────────────────────────────────
# En el servidor también NODE_ENV=production (no en el .env de desarrollo)
HOST=0.0.0.0
PORT=4321

# Dominio sin https (definir ANTES del build)
ALLOWED_HOSTS=tudominio.com,www.tudominio.com
SITE_URL=https://tudominio.com

# Base de datos (Turso o archivo en disco persistente)
DATABASE_URL=file:./data/mel.db
DATABASE_AUTH_TOKEN=

# Correo de avisos a Melanie (Gmail con contraseña de aplicación, sin espacios)
# Sin SMTP_HOST ni RESEND_API_KEY, el correo solo se escribe en la consola.
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=vivefelizviveseguro@gmail.com
# Alternativa a Gmail: Resend con dominio verificado (MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Fotos de "Deja tu opinión" (disco persistente)
STORAGE_DIR=./data/uploads

# Clave de sesiones: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Agenda de Google de Melanie (vacío = agendador por WhatsApp)
PUBLIC_GOOGLE_CALENDAR_URL=

# ── PANEL Y PORTAL (no hacen falta para la landing) ──────
ADMIN_EMAIL=admin@mel.test
ADMIN_PASSWORD=demo-mel-2026
ADMIN_NAME=Melanie O. Calderón Vega
ADMIN_SESSION_HOURS=12
RETENCION_DESCARTADAS_DIAS=180
BACKUP_DIR=./data/backups
BACKUP_CONSERVAR=14
