# Plantilla de variables de entorno de Mel – Corredora de Seguros.
#
# Este archivo SÍ va en Git: es solo la plantilla, sin datos secretos.
# Para usarlo, cópialo como .env (ese NUNCA se sube; está en .gitignore) o carga
# las variables en el panel de tu hosting, y completa los valores vacíos.
# Una variable vacía (NOMBRE=) cuenta como no definida y usa su valor por defecto.
#
# Parte 1: lo que necesita la LANDING para publicarse.
# Parte 2: panel de Melanie y portal (boceto, no hace falta para la landing).

# ═════════════════════════════════════════════════════════════════════════════
# PARTE 1 · LANDING (despliegue)
# ═════════════════════════════════════════════════════════════════════════════

# ── Servidor ─────────────────────────────────────────────────────────────────
# Dirección y puerto donde escucha el servidor. Muchos hostings ponen PORT solos.
# En el servidor además debe estar NODE_ENV=production (lo pone el hosting o el
# comando de arranque; no lo pongas en el .env de desarrollo).
HOST=0.0.0.0
PORT=4321

# ── Dominio ──────────────────────────────────────────────────────────────────
# Dominio(s) de la página, separados por coma, sin https. Se lee al CONSTRUIR
# (npm run build): defínelo ANTES del build. Sin esto, detrás de un proxy los
# formularios dan error 403. Ejemplo: melcorredora.pe,www.melcorredora.pe
ALLOWED_HOSTS=
# URL pública del sitio, con https (enlaces dentro de los correos).
# Ejemplo: https://melcorredora.pe
SITE_URL=

# ── Base de datos ────────────────────────────────────────────────────────────
# Guarda las solicitudes de cotización y las recomendaciones.
# Desarrollo: archivo local (se crea solo).
# Producción: URL de Turso (libsql://<base>-<usuario>.turso.io) + su token,
# o un archivo en un disco persistente (que no se borre al reiniciar).
# No cargues los datos de la demo (db:seed:demo) en la base de producción.
DATABASE_URL=file:./data/mel.db
DATABASE_AUTH_TOKEN=

# ── Correo de avisos a Melanie ───────────────────────────────────────────────
# Cada cotización, contacto o recomendación nueva le llega por correo.
# Recomendado: Resend (https://resend.com) con el dominio verificado.
RESEND_API_KEY=
# Remitente. Vacío = Mel – Corredora de Seguros <onboarding@resend.dev>, que solo
# envía al correo de la cuenta de Resend (sirve para probar).
# Ejemplo: Mel – Corredora de Seguros <avisos@melcorredora.pe>
MAIL_FROM=
# Destinatario de los avisos: el correo oficial de Melanie.
MAIL_TO=vivefelizviveseguro@gmail.com
# Proveedor: resend | smtp | console. Vacío = Resend si hay RESEND_API_KEY,
# SMTP si hay SMTP_HOST y, si no, el correo solo se escribe en la consola.
MAIL_PROVIDER=

# Alternativa SMTP (solo si no usas Resend; se usa cuando SMTP_HOST tiene valor).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Archivos subidos ─────────────────────────────────────────────────────────
# Fotos o logos de "Deja tu opinión" (fuera de public/). En producción, una
# carpeta en un disco persistente.
STORAGE_DIR=./data/uploads

# ── Seguridad ────────────────────────────────────────────────────────────────
# Clave para firmar sesiones. Obligatoria en producción (aunque solo se publique
# la landing, sin ella la ruta /admin da error 500). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Agenda de Google Calendar (opcional) ─────────────────────────────────────
# Programación de citas de Melanie: Calendar → Crear → Programación de citas →
# Compartir → "Añadir a tu sitio web" → copia la URL del src del iframe.
# Se lee al CONSTRUIR. Vacío = la página usa su propio agendador, que confirma
# la cita por WhatsApp.
# Ejemplo: https://calendar.google.com/calendar/appointments/schedules/XXXXXXXX
PUBLIC_GOOGLE_CALENDAR_URL=

# ═════════════════════════════════════════════════════════════════════════════
# PARTE 2 · PANEL /admin Y PORTAL (no hace falta para la landing)
# ═════════════════════════════════════════════════════════════════════════════

# ── Cuenta administradora ────────────────────────────────────────────────────
# La crea `npm run db:seed` (volver a ejecutarlo actualiza la contraseña).
# Estos valores son SOLO de prueba para desarrollo: no los copies a producción;
# allí define otros (mín. 12 caracteres).
ADMIN_EMAIL=admin@mel.test
ADMIN_PASSWORD=demo-mel-2026
ADMIN_NAME=Melanie O. Calderón Vega
# Duración de la sesión del panel, en horas.
ADMIN_SESSION_HOURS=12

# ── Protección de datos y copias ─────────────────────────────────────────────
# Días que se guarda una solicitud descartada antes de borrarla.
RETENCION_DESCARTADAS_DIAS=180
# Carpeta y cantidad de copias de seguridad que conserva npm run db:backup.
BACKUP_DIR=./data/backups
BACKUP_CONSERVAR=14

# ── Demo ─────────────────────────────────────────────────────────────────────
# 1 = permite npm run db:seed:demo con NODE_ENV=production (solo en una base de
# demo). Vacío en cualquier otro caso.
DEMO_MODE=
