# Página de reservas de Google Calendar (opcional).
# Calendar → Crear → Programación de citas → Compartir → "Añadir a tu sitio web" → copia la URL del src del iframe.
# Si no se define, se usa una programación de prueba. Para desactivar Google Calendar y usar el
# agendador propio, déjala vacía entre comillas: PUBLIC_GOOGLE_CALENDAR_URL=""
# Ejemplo: https://calendar.google.com/calendar/appointments/schedules/XXXXXXXX
# PUBLIC_GOOGLE_CALENDAR_URL=

# ── Servidor y base de datos (issue #38) ─────────────────────────────────────
# Base de datos libSQL. En desarrollo basta un archivo local (se crea solo).
# En la demo publicada: la URL de Turso (libsql://<base>-<usuario>.turso.io) y su token.
DATABASE_URL=file:./data/mel.db
# DATABASE_AUTH_TOKEN=

# ── Avisos por correo a Melanie (issue #39) ──────────────────────────────────
# Proveedor: resend | smtp | console. Si se omite: Resend si hay RESEND_API_KEY, SMTP si hay
# SMTP_HOST y, si no hay ninguno, el correo se escribe en la consola (desarrollo).
# MAIL_PROVIDER=
# RESEND_API_KEY=
# Destinatario de los avisos (por defecto, el correo oficial de Melanie).
# MAIL_TO=vivefelizviveseguro@gmail.com
# Remitente. Con Resend sin dominio verificado, usa onboarding@resend.dev (solo envía al
# correo de la cuenta de Resend).
# MAIL_FROM=Mel – Corredora de Seguros <onboarding@resend.dev>
# Alternativa SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# URL pública del sitio, para los enlaces al panel dentro de los correos.
# SITE_URL=http://localhost:4321

# ── Panel privado /admin (issue #40) ─────────────────────────────────────────
# Cuenta administradora que crea `npm run db:seed` (volver a ejecutarlo actualiza la contraseña).
# Estos valores son SOLO de prueba para desarrollo; en producción define otros (mín. 12 caracteres).
ADMIN_EMAIL=admin@mel.test
ADMIN_PASSWORD=demo-mel-2026
# ADMIN_NAME=Melanie O. Calderón Vega
# Clave para firmar las sesiones (obligatoria en producción). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=
# Duración de la sesión del panel, en horas.
# ADMIN_SESSION_HOURS=12
